{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cargo build --workspace",
      "group": "build",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build (release)",
      "type": "shell",
      "command": "cargo build --workspace --release",
      "group": "build",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Check",
      "type": "shell",
      "command": "cargo check --workspace --all-targets",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Check License",
      "type": "shell",
      "command": "cargo deny check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Clippy",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Fmt (Rust)",
      "type": "shell",
      "command": "cargo fmt --all -- --check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Fmt (oxfmt, non-Rust)",
      "type": "shell",
      "command": "pnpm exec oxfmt --check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Fmt",
      "dependsOrder": "sequence",
      "dependsOn": ["Fmt (oxfmt, non-Rust)", "Fmt (Rust)"],
      "problemMatcher": []
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "cargo run -p oxtuner-app",
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Watch (bacon)",
      "type": "shell",
      "command": "bacon",
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "CI bar (fmt + clippy + test + deny)",
      "dependsOrder": "sequence",
      "dependsOn": ["Fmt", "Clippy", "Test", "cargo-deny"],
      "problemMatcher": []
    }
  ]
}
